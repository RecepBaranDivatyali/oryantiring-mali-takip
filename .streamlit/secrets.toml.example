# Bu dosyayı "secrets.toml" adıyla kopyalayıp doldurun (yerel çalıştırma için).
# Streamlit Cloud'da aynı içerik Settings > Secrets bölümüne yapıştırılır.
# secrets.toml GitHub'a GİTMEZ (.gitignore'da).

SUPABASE_URL = "https://xxxx.supabase.co"
SUPABASE_KEY = "anon-key"

# Boş bırakmayın: uzun, rastgele bir metin (giriş bağlantılarını imzalar)
AUTH_SECRET = "uzun-rastgele-bir-metin"

[APP_USERS]
ben = "guclu-bir-sifre"
arkadas = "arkadasin-sifresi"
